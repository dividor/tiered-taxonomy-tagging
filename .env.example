# Copy this file to .env and fill it in. Never commit .env.

# Folder for the test sets, saved model replies, embeddings and trained models. A full run leaves about 12 GB
# there. Keep it outside this repository.
TAXONOMY_DATA_ROOT=/path/to/taxonomy_test_sets

# A Hugging Face dataset of yours that the GPU jobs upload their outputs to. scripts/gpu_jobs.py creates it,
# private, if it does not exist.
TAXONOMY_JOBS_DATASET=your-hf-name/tiered-taxonomy-jobs

# The Hugging Face token is read from HF_TOKEN, or from `hf auth login` (~/.cache/huggingface/token). It needs
# permission to call Inference Providers, to run Jobs and to write to the dataset above. It is never written
# anywhere in this repository.
# HF_TOKEN=
